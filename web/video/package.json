{
  "name": "sbt-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "capture": "python3 capture/capture.py",
    "tts": "python3 tts/tts.py",
    "music:pad": "python3 music/make_pad.py 24",
    "studio": "remotion studio src/index.ts",
    "render:test": "remotion render src/index.ts Test out/test.mp4",
    "stills": "for t in 1.4 5.5 9.6 11.6; do ffmpeg -y -loglevel error -ss $t -i out/test.mp4 -frames:v 1 out/still_${t}s.png; done",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@remotion/cli": "4.0.543",
    "@remotion/media-utils": "4.0.543",
    "@remotion/transitions": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
